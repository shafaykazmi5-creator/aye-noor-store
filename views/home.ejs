<%- include("partials/header") %>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">MADE FOR THE MOMENTS THAT MATTER</p>
    <h1>Let your little<br><em>moments glow.</em></h1>
    <p class="hero-description">Candles that turn everyday rituals into thoughtful, beautiful moments. Explore our sample collection while we build the Aye Noor store.</p>
    <div class="hero-actions">
      <a class="dark-button" href="/shop">Explore the collection <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-note"><span class="tiny-star" aria-hidden="true">✳</span> A warm little world of candles and gifting</div>
  </div>
  <div class="hero-art" role="img" aria-label="Decorative candle still-life illustration">
    <div class="sun-disc"></div><div class="arch arch-back"></div><div class="arch arch-front"></div>
    <div class="pedestal"></div><div class="candle candle-tall"><i></i><b></b></div>
    <div class="candle candle-small"><i></i><b></b></div>
    <div class="flower flower-one">✿</div><div class="flower flower-two">✿</div>
    <div class="art-caption">LIGHT · SCENT · SENTIMENT</div>
  </div>
</section>

<section class="intro-strip" aria-label="Brand highlights">
  <span>THOUGHTFULLY GIFTABLE</span><span class="strip-flower" aria-hidden="true">✳</span><span>DESIGNED TO DELIGHT</span><span class="strip-flower" aria-hidden="true">✳</span><span>MADE FOR YOUR MOMENTS</span>
</section>

<section class="section" id="categories">
  <div class="section-heading">
    <div><p class="eyebrow">FIND YOUR FAVOURITE</p><h2>Shop by <em>mood.</em></h2></div>
    <p>From playful shapes to comforting scents, find a little something that feels like you.</p>
  </div>
  <div class="category-grid" id="categoryGrid">
    <% categories.forEach(cat => { %>
      <a
        class="category-card"
        href="/shop?category=<%= encodeURIComponent(cat.name) %>"
        data-category-select="<%= cat.name %>"
        style="--catbg:<%= cat.visual.bg %>"
      >
        <span class="category-art" aria-hidden="true"><%= cat.visual.mark %></span>
        <span class="category-name"><%= cat.name %></span>
      </a>
    <% }) %>
  </div>
</section>

<section class="section shop-section" id="shop">
  <div class="section-heading shop-heading">
    <div><p class="eyebrow">THE SAMPLE COLLECTION</p><h2>Small things, <em>special feels.</em></h2></div>
    <div class="shop-tools">
      <label class="filter-label" for="categoryFilter">Collection</label>
      <select id="categoryFilter">
        <option value="all">All collections</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.name %>"><%= cat.name %></option>
        <% }) %>
      </select>
      <label class="filter-label" for="sortSelect">Sort</label>
      <select id="sortSelect">
        <option value="featured">Featured</option>
        <option value="low-high">Price: low to high</option>
        <option value="high-low">Price: high to low</option>
        <option value="name">Name A–Z</option>
      </select>
    </div>
  </div>
  
  <div class="product-grid" id="productGrid" aria-live="polite">
    <% allProducts.forEach(product => { %>
      <%- include("partials/product-card", { product }) %>
    <% }) %>
  </div>
  <p class="empty-state hidden" id="emptyState">No products match your search. Try another term or collection.</p>
</section>

<section class="story-section" id="story">
  <div class="story-mark" aria-hidden="true">AN</div>
  <div>
    <p class="eyebrow">A NOTE FROM AYE NOOR</p>
    <h2>Small rituals.<br><em>Lasting warmth.</em></h2>
    <p>This is a working design prototype. Our final brand story, product photography, policies and real catalogue will be added when they're ready.</p>
    <a class="text-link" href="/shop">Open full shop page <span aria-hidden="true">↗</span></a>
  </div>
  <div class="story-spark" aria-hidden="true">✳</div>
</section>

<%- include("partials/footer") %>
