<%- include("partials/header") %>
<main id="main-content" class="section" style="padding:3rem 0;"><div class="container" style="max-width:680px;margin:0 auto;"><div style="background:#fff;border:1px solid #e5dcd1;border-radius:14px;padding:1.75rem;"><p class="eyebrow" style="margin:0 0 0.35rem;">REAL-TIME ORDER TRACKER</p><h1 style="margin:0 0 0.6rem;font-size:1.75rem;">Track Your Aye Noor Order</h1><p style="color:#6e6259;font-size:0.92rem;margin-bottom:1.2rem;">Enter your Order Number and the last 4 digits of your mobile number.</p><form id="liveOrderTrackForm" style="display:grid;grid-template-columns:1fr 1fr auto;gap:0.65rem;align-items:end;"><div><label for="trackOrderNum" style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.3rem;">Order Number</label><input id="trackOrderNum" type="text" placeholder="e.g. AN-261016-1009" required style="width:100%;padding:0.6rem;border:1px solid #d8cbb8;border-radius:8px;text-transform:uppercase;"></div><div><label for="trackPhone" style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.3rem;">Phone (Full or Last 4 Digits)</label><input id="trackPhone" type="text" placeholder="e.g. 7200" required style="width:100%;padding:0.6rem;border:1px solid #d8cbb8;border-radius:8px;"></div><button type="submit" class="button button-primary" style="padding:0.65rem 1.2rem;">Track Order</button></form><div id="trackResultBox" role="status" aria-live="polite" style="margin-top:1.2rem;display:none;"></div></div></div></main><script>function mk(t,txt,s){const e=document.createElement(t);if(txt!=null)e.textContent=String(txt);if(s)e.style.cssText=s;return e;}document.getElementById("liveOrderTrackForm").addEventListener("submit",async function(ev){ev.preventDefault();const box=document.getElementById("trackResultBox");box.style.display="block";box.replaceChildren(mk("p","Checking order status..."));try{const r=await fetch("/api/order-status",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({orderNumber:document.getElementById("trackOrderNum").value.trim(),phone:document.getElementById("trackPhone").value.trim()})});const d=await r.json();if(!d.ok){box.replaceChildren(mk("div","?? "+(d.message||"Order not found."),"padding:0.9rem;background:#fef2f2;color:#991b1b;border-radius:8px;"));return;}const o=d.order,card=mk("div",null,"padding:1.1rem;background:#faf6f0;border:1px solid #e5dcd1;border-radius:10px;"),top=mk("div",null,"display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem;");top.append(mk("strong","Order #"+o.orderNumber),mk("span",o.status,"padding:0.25rem 0.7rem;border-radius:999px;font-weight:700;font-size:0.82rem;background:#1e1916;color:#fff;"));const ul=mk("ul",null,"margin:0.5rem 0;padding-left:1.2rem;font-size:0.9rem;");(o.items||[]).forEach(i=>ul.appendChild(mk("li",i.name+" ? "+i.qty+" ? Rs. "+Number(i.lineTotal).toLocaleString("en-PK"))));card.append(top,mk("p","Customer: "+o.customerName+" ("+o.city+", "+o.province+")","margin:0.25rem 0;font-size:0.9rem;"),ul);if(Number(o.discountAmount)>0)card.appendChild(mk("p","Voucher ("+o.voucherCode+"): -Rs. "+Number(o.discountAmount).toLocaleString("en-PK"),"margin:0.25rem 0;color:#18633b;font-size:0.88rem;font-weight:600;"));card.appendChild(mk("p","Total COD Payable: Rs. "+Number(o.total).toLocaleString("en-PK"),"margin:0.4rem 0 0;font-size:0.95rem;font-weight:700;"));box.replaceChildren(card);}catch(err){box.replaceChildren(mk("div","?? Could not connect to server.","padding:0.9rem;background:#fef2f2;color:#991b1b;border-radius:8px;"));}});</script>
<%- include("partials/footer") %>


