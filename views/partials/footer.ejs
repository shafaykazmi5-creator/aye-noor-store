  </main>

  <footer class="footer" id="contact">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="wordmark footer-wordmark" href="/" aria-label="Aye Noor home">AYE <span>NOOR</span><small>OBJECTS OF LIGHT</small></a>
        <p class="footer-tagline">Candles shaped for warm rooms, quiet evenings, and thoughtful gifting.</p>
        <p class="footer-tbd">Official WhatsApp, phone, and social links will be added once confirmed.</p>
      </div>

      <nav class="footer-col" aria-label="Shop navigation">
        <h3>Shop</h3>
        <a href="/shop">All Candles</a>
        <a href="/shop?category=Flower%20Candles">Flower Candles</a>
        <a href="/shop?category=Bear%20Candles">Bear Candles</a>
        <a href="/shop?category=Scented%20Candles">Scented Candles</a>
        <a href="/shop?category=Gift%20Sets">Gift Sets</a>
      </nav>

      <nav class="footer-col" aria-label="Brand navigation">
        <h3>Aye Noor</h3>
        <a href="/about">Our Story</a>
        <a href="/contact">Contact Us</a>
        <a href="/faq">FAQ</a>
        <a href="/cart">Shopping Cart</a>
      </nav>

      <nav class="footer-col" aria-label="Policies navigation">
        <h3>Policies (TBD)</h3>
        <a href="/shipping">Shipping Policy</a>
        <a href="/returns">Return Policy</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© <span id="year"><%= new Date().getFullYear() %></span> Aye Noor · Development prototype</span>
      <span class="footer-copy">Prices in Pakistani Rupees (Rs.) · Sample catalogue active</span>
    </div>
  </footer>

  <div class="overlay hidden" id="cartOverlay"></div>
  <aside class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-labelledby="cartTitle" aria-hidden="true" inert>
    <div class="drawer-header">
      <div>
        <p class="eyebrow">YOUR SELECTION</p>
        <h2 id="cartTitle">Your cart</h2>
      </div>
      <button class="close-button" id="closeCart" type="button" aria-label="Close cart">×</button>
    </div>
    <div class="drawer-shipping-banner" id="drawerShippingNote">
      Free shipping on orders from <%= formatMoney(storeConfig.freeShippingThreshold) %>.
    </div>
    <div class="cart-items" id="cartItems"></div>
    <div class="cart-empty" id="cartEmpty">
      <span aria-hidden="true">✳</span>
      <h3>Your cart is empty</h3>
      <p>Find a little something to make someone's day.</p>
    </div>
    <div class="cart-footer">
      <div class="subtotal-row">
        <span>Subtotal</span>
        <strong id="cartSubtotal">Rs. 0</strong>
      </div>
      <div class="drawer-meta-row">
        <span>Estimated shipping</span>
        <span id="cartDrawerShipping">Calculated at checkout</span>
      </div>
      <div class="drawer-actions">
        <a class="outline-button full-button" href="/cart">View full cart</a>
        <a class="dark-button full-button" id="drawerCheckoutLink" href="/checkout">Checkout <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </aside>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
