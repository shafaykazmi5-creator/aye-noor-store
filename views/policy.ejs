<%- include("partials/header") %>

<section class="section page-hero-section">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= policy.title %></span>
  </nav>

  <div class="policy-layout">
    <aside class="policy-sidebar" aria-label="Store policies">
      <p class="eyebrow">STORE POLICIES</p>
      <nav class="policy-nav">
        <% allPolicies.forEach(p => { %>
          <a href="/<%= p.slug %>" <%- p.slug === policy.slug ? 'aria-current="page"' : '' %>><%= p.title %></a>
        <% }) %>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact Us</a>
      </nav>
    </aside>

    <article class="policy-content-card">
      <p class="eyebrow"><%= policy.eyebrow %></p>
      <h1><%= policy.title %></h1>
      <p class="policy-updated">Status: <%= policy.updated %></p>

      <div class="tbd-callout">
        <strong>ⓘ Prototype Placeholder:</strong> <%= policy.intro %>
      </div>

      <div class="policy-sections">
        <% policy.sections.forEach(sec => { %>
          <section class="policy-block">
            <h2><%= sec.heading %></h2>
            <p><%= sec.body %></p>
          </section>
        <% }) %>
      </div>
    </article>
  </div>
</section>

<%- include("partials/footer") %>
